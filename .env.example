# ==============================================================================
# Birthday Universe Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/music
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/music

# ------------------------------------------------------------------------------
# 2. Server-Side Allowed Google Accounts (Strict Allowlist)
# Real email addresses must stay server-side — NEVER prefix with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
ALLOWED_GOOGLE_ACCOUNT_1=tanu.mau@example.com
ALLOWED_GOOGLE_ACCOUNT_2=sender@example.com

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 Key — SERVER-SIDE ONLY
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser bundle
# Obtain from: https://console.cloud.google.com
#   1. Enable "YouTube Data API v3" on your project
#   2. Go to Credentials -> Create credentials -> API Key
#   3. Restrict the key to YouTube Data API v3
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. Production Photo Storage: Vercel Private Blob
# 
# LOCAL ENVIRONMENT:
#   Photos are read from the local server-side directory: private/photos/
#   (Local files are gitignored and never committed to GitHub).
#
# VERCEL PRODUCTION ENVIRONMENT:
#   Photos are securely fetched server-side from Vercel Private Blob.
#   NEVER prefix with NEXT_PUBLIC_ — Blob credentials must stay on the server.
#   Endpoint /api/private/photos/[id] acts as the secure streaming boundary.
#
# Obtain from: Vercel Dashboard -> Storage -> Blob Store -> .env.local tab:
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# If using Vercel OIDC on modern enterprise setups, VERCEL_OIDC_TOKEN is auto-injected.

# ------------------------------------------------------------------------------
# 5. Feature Flags
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_PRIVATE_PHOTOS=true
