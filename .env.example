# Clerk Authentication Configuration
# Obtain from your Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/music


# Server-Side Allowed Google Accounts (Strict 2-Account Allowlist)
# ONLY these exact two Google email accounts will be authorized to access the private birthday universe
ALLOWED_GOOGLE_ACCOUNT_1=first@gmail.com
ALLOWED_GOOGLE_ACCOUNT_2=second@gmail.com

# Optional Vercel Blob Read-Write Token (for cloud private photo storage in production)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# YouTube Data API v3 Key — SERVER-SIDE ONLY
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser bundle
# Obtain from: https://console.cloud.google.com
#   1. Enable "YouTube Data API v3" on your project
#   2. Go to Credentials → Create credentials → API Key
#   3. Restrict the key to YouTube Data API v3 + your server IP/domain
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
