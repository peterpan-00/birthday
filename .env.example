# ==============================================================================
# Birthday Universe — Environment Configuration
# ==============================================================================
# RULES:
# 1. Variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# 2. Variables WITHOUT NEXT_PUBLIC_ are strictly server-side and NEVER sent to the browser.
# 3. NEVER commit real credentials, tokens, or private photos to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (Public + Server-Side Secret)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/music
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/music

# ------------------------------------------------------------------------------
# 2. Server-Side Allowed Google Accounts (Strict Allowlist)
# Real email addresses must stay server-side — NEVER prefix with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
ALLOWED_GOOGLE_ACCOUNT_1=tanu.mau@example.com
ALLOWED_GOOGLE_ACCOUNT_2=sender@example.com

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 Key — SERVER-SIDE ONLY
# NEVER prefix with NEXT_PUBLIC_ — protects API quota from browser exposure.
# Obtain from: https://console.cloud.google.com (Credentials -> API Key)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. Production Storage: Vercel Private Blob (Photos + Notes Persistence)
#
# LOCAL ENVIRONMENT:
#   Photos resolve from server-only `private/photos/` (gitignored).
#   Notes persist to local `private/data/notes.json` or `/tmp`.
#
# VERCEL PRODUCTION ENVIRONMENT:
#   Connect a Vercel Blob store to your project in the Vercel Dashboard.
#   Vercel automatically provisions BLOB_READ_WRITE_TOKEN.
#   Private photos path: birthday/photos/[photoId].jpg
#   Private notes path:  birthday/data/notes.json
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ------------------------------------------------------------------------------
# 5. Feedback Email Backend (Resend) — SERVER-SIDE ONLY
# Obtain API key from: https://resend.com
# If unset in development, feedback route logs simulated delivery to server console.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
FEEDBACK_TO_EMAIL=otonge30@gmail.com
FEEDBACK_FROM_EMAIL=Birthday Experience <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. Feature Flags
# Enabled by default in code. Set to "false" to disable.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_PRIVATE_PHOTOS=true
ENABLE_PHOTO_DIAGNOSTICS=false
